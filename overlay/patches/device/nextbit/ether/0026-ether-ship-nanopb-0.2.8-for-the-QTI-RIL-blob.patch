From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Thu, 24 Sep 2026 08:30:09 -0400
Subject: [PATCH] ether: ship nanopb 0.2.8 for the QTI RIL blob

libril-qc-qmi-1.so imports pb_encode/pb_decode instead of carrying its own nanopb, and its
descriptors were generated against nanopb 0.2.8 -- what Android 7.1.1 shipped. Modern nanopb inserted
PB_LTYPE_BOOL at 0x00 and shifted every other PB_LTYPE_* up by one, so the 0.3.9.8 runtime in libril
reads every field as the next type along and nothing the IMS service sends decodes.

libril keeps the modern runtime, because librilutils generates its SAP descriptors with the modern
generator, and now hides its pb_* exports. This adds the 0.2.8 runtime as a separate vendor library
and shims it onto the blob, which already carries two other shims, so the mechanism is proven on this
exact library -- confirmed on hardware by libnanopb_legacy appearing in rild's maps.

Built at 0.2.8's default 8-bit field width. Forcing 32-bit reproduced the original SIGSEGV in
encode_field, from the blob this time, because the iterator stride runs off the end of the
descriptor array.

Sources are verbatim from external/nanopb-c at tag android-7.1.1_r1 -- five files, zlib licence --
so the version is pinned to what this device's own stock ROM was built with.
---
 BoardConfig.mk           |    8 +
 device.mk                |    4 +
 nanopb-0.2.8/Android.bp  |   44 ++
 nanopb-0.2.8/LICENSE.txt |   20 +
 nanopb-0.2.8/pb.h        |  519 +++++++++++++++++
 nanopb-0.2.8/pb_decode.c | 1178 ++++++++++++++++++++++++++++++++++++++
 nanopb-0.2.8/pb_decode.h |  149 +++++
 nanopb-0.2.8/pb_encode.c |  667 +++++++++++++++++++++
 nanopb-0.2.8/pb_encode.h |  154 +++++
 9 files changed, 2743 insertions(+)
 create mode 100644 nanopb-0.2.8/Android.bp
 create mode 100644 nanopb-0.2.8/LICENSE.txt
 create mode 100644 nanopb-0.2.8/pb.h
 create mode 100644 nanopb-0.2.8/pb_decode.c
 create mode 100644 nanopb-0.2.8/pb_decode.h
 create mode 100644 nanopb-0.2.8/pb_encode.c
 create mode 100644 nanopb-0.2.8/pb_encode.h

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 53cf72e..eb67f70 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -170,6 +170,14 @@ TARGET_LD_SHIM_LIBS += \
 TARGET_LD_SHIM_LIBS += \
     /system/vendor/lib/libmmcamera2_isp_modules.so|libshims_camera_mutex.so
 
+# libril-qc-qmi-1.so imports pb_encode/pb_decode instead of carrying its own nanopb, and its
+# descriptors were generated against nanopb 0.2.8. Modern nanopb shifted every PB_LTYPE_* up by one
+# when it added PB_LTYPE_BOOL, so the 0.3.x runtime in libril misreads every field and nothing the
+# IMS service sends decodes. libril now hides its pb_* exports, and this binds the blob to a 0.2.8
+# runtime instead.
+TARGET_LD_SHIM_LIBS += \
+    /system/vendor/lib64/libril-qc-qmi-1.so|libnanopb_legacy.so
+
 # WiFi
 BOARD_HAS_QCOM_WLAN              := true
 BOARD_HOSTAPD_DRIVER             := NL80211
diff --git a/device.mk b/device.mk
index 0dbe388..4614503 100644
--- a/device.mk
+++ b/device.mk
@@ -373,6 +373,10 @@ PRODUCT_PACKAGES += ims
 # The bridge from that 7.1 IMS stack to the modern telephony framework. See VOLTE-BRINGUP.md.
 PRODUCT_PACKAGES += ImsBridge
 
+# nanopb 0.2.8, for libril-qc-qmi-1.so alone. See nanopb-0.2.8/Android.bp for why a second copy of
+# nanopb has to exist at all.
+PRODUCT_PACKAGES += libnanopb_legacy
+
 # Without this feature PhoneGlobals never constructs an ImsResolver at all, so nothing binds the
 # bridge and nothing says why. It is the first thing to check if IMS looks inert.
 PRODUCT_PACKAGES += android.hardware.telephony.ims.prebuilt.xml
diff --git a/nanopb-0.2.8/Android.bp b/nanopb-0.2.8/Android.bp
new file mode 100644
index 0000000..d34cc35
--- /dev/null
+++ b/nanopb-0.2.8/Android.bp
@@ -0,0 +1,44 @@
+//
+// nanopb 0.2.8 -- the version Android 7.1.1 shipped, kept here for one reason.
+//
+// QTI's libril-qc-qmi-1.so imports pb_encode/pb_decode from libril rather than carrying its own
+// copy, and its message descriptors were generated against nanopb 0.2.8. Between 0.2.8 and 0.3.x
+// nanopb inserted PB_LTYPE_BOOL at 0x00 and shifted every other PB_LTYPE_* up by one, so a modern
+// runtime reads every field of those descriptors as the next type along: VARINT as BOOL, STRING as
+// SUBMESSAGE, and so on. Nothing decodes, and no PB_FIELD_8/16/32BIT setting can help -- the width
+// is not what differs.
+//
+// libril cannot simply be built against 0.2.8 instead: librilutils generates its SAP descriptors at
+// build time with the current generator, so libril's own protos need the modern runtime. The two
+// coexist by keeping this one separate and hiding libril's pb_* exports, which lets the blob bind
+// here while libril keeps using its own internally.
+//
+// Sources are verbatim from external/nanopb-c at tag android-7.1.1_r1. zlib licence, see LICENSE.txt.
+//
+package {
+    default_applicable_licenses: ["Android-Apache-2.0"],
+}
+
+cc_library_shared {
+    name: "libnanopb_legacy",
+    vendor: true,
+
+    srcs: [
+        "pb_decode.c",
+        "pb_encode.c",
+    ],
+    export_include_dirs: ["."],
+
+    // Default field width. 0.2.8's pb_size_t is uint8_t unless PB_FIELD_16BIT/32BIT says otherwise,
+    // and the blob's descriptors were built that way: forcing 32-bit here reproduced the original
+    // SIGSEGV in encode_field exactly, because the iterator stride runs off the end of the array.
+    //
+    // PB_ENABLE_MALLOC is kept -- 0.2.8 needs it for the pointer-type fields these descriptors use.
+    cflags: [
+        "-DPB_ENABLE_MALLOC",
+        "-Wno-unused-parameter",
+        "-Wno-sign-compare",
+    ],
+
+    sdk_version: "",
+}
