From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Thu, 24 Sep 2026 19:48:10 -0400
Subject: [PATCH] ether: label the properties fifteen denials were actually
 asking for

Fifteen avc denials on property reads, from ten domains. A denial names the domain and the type,
never the property, so the shape of the problem was invisible: it looked like fifteen bugs.

Ten of them are one bug and it is cosmetic. ro.lineage.* is unlabelled, so it lands on default_prop,
and LineageOS's own debuggerd patch reads it in every process --

    tombstone_proto.cpp:645
      result.set_lineage_version(GetProperty("ro.lineage.version", "unknown"));

-- with the crash handler installed everywhere, including statically inside the linker. So every
vendor domain that lacks default_prop logs a denial for a tombstone field that falls back to
"unknown". Labelling it build_prop fixes all ten with no allow rules, because
system/sepolicy/public/domain.te already has get_prop(domain, build_prop).

The two that matter were buried under those ten:

  - hwcomposer.msm8992.so reads persist.hwc.*, persist.mdpcomp* and persist.metadata_dynfps.*, and
    could read none of them. The composer has been running on defaults for its MDP composition and
    dynamic-fps tuning this whole time.
  - rild reads persist.data.netmgrd.* and persist.data.tcp_rst_drop through libdsi_netctrl.so.

Types rather than a wider grant: get_prop(<domain>, default_prop) would hand each of these read
access to every unlabelled property on the system, including whatever a future branch adds. Note
netmgrd.te already took that shortcut, which is why it gets vendor_data_prop explicitly here --
relabelling those two names would otherwise quietly remove access it currently has.

persist.data.iwlan.* is deliberately left on default_prop for the same reason: qmuxd reads it and is
not denied.

ro.product.locale also showed up, for cnd and mm-qcamerad. It is unlabelled upstream too and the
effect is cosmetic, so it is left alone rather than diverging from AOSP.

Found with forge's prop-denials.sh, which takes the intersection of the property names a domain's
mapped binaries reference with the type it is being refused.
---
 sepolicy/hal_graphics_composer_default.te |  4 ++++
 sepolicy/netmgrd.te                       |  4 ++++
 sepolicy/property.te                      |  1 +
 sepolicy/property_contexts                | 26 +++++++++++++++++++++++
 sepolicy/rild.te                          |  4 ++++
 5 files changed, 39 insertions(+)

diff --git a/sepolicy/hal_graphics_composer_default.te b/sepolicy/hal_graphics_composer_default.te
index db7d574..6c80bbe 100644
--- a/sepolicy/hal_graphics_composer_default.te
+++ b/sepolicy/hal_graphics_composer_default.te
@@ -1,3 +1,7 @@
 # The composer HAL polls the boot animation property; denied reads spin at several hundred per
 # second and keep the CPU busy for the whole hang.
 get_prop(hal_graphics_composer_default, bootanim_system_prop);
+
+# persist.hwc.* / persist.mdpcomp* / persist.metadata_dynfps.*, now labelled rather than
+# falling through to default_prop. hwcomposer.msm8992.so is the only consumer.
+get_prop(hal_graphics_composer_default, vendor_display_prop)
diff --git a/sepolicy/netmgrd.te b/sepolicy/netmgrd.te
index 6d8998e..174bb74 100644
--- a/sepolicy/netmgrd.te
+++ b/sepolicy/netmgrd.te
@@ -8,3 +8,7 @@
 # device/lineage/sepolicy/qcom/legacy-vendor, which 20.0 deleted along with its
 # pre-UM platform support. Restored here as device policy.
 get_prop(netmgrd, default_prop)
+
+# The same data switches. netmgrd could already read them, but only via the blanket
+# get_prop(netmgrd, default_prop) above; relabelling them would otherwise take that away.
+get_prop(netmgrd, vendor_data_prop)
diff --git a/sepolicy/property.te b/sepolicy/property.te
index 5c1b515..9a8321c 100644
--- a/sepolicy/property.te
+++ b/sepolicy/property.te
@@ -1,3 +1,4 @@
 type audio_smartamp_init_prop, property_type;
 type vendor_timekeep_prop, property_type;
 type vendor_cne_prop, property_type;
+type vendor_data_prop, property_type;
diff --git a/sepolicy/property_contexts b/sepolicy/property_contexts
index ba770ba..a84b734 100644
--- a/sepolicy/property_contexts
+++ b/sepolicy/property_contexts
@@ -24,3 +24,29 @@ bluetooth.core.le.vendor_capabilities.enabled    u:object_r:bluetooth_config_pro
 # take away access they currently have.
 persist.cne.            u:object_r:vendor_cne_prop:s0
 persist.vendor.cnd.     u:object_r:vendor_cne_prop:s0
+
+# ro.lineage.* is unlabelled, so it lands on default_prop, and LineageOS's debuggerd patch reads it
+# in every process: tombstone_proto.cpp does
+#     result.set_lineage_version(GetProperty("ro.lineage.version", "unknown"))
+# and the crash handler is installed everywhere, including statically inside the linker. Every vendor
+# domain without default_prop therefore logs a denial, on this device ten of them -- the composer,
+# the camera daemon, sensors, thermal-engine, msm_irqbalanced, the GNSS HAL, mediacodec, cnd, rild.
+# The consequence is only that a tombstone says "unknown", but it buries every denial that does
+# matter under ten copies of one that does not.
+#
+# build_prop rather than a new type: system/sepolicy/public/domain.te has get_prop(domain,
+# build_prop), so labelling it here fixes all ten with no allow rules at all.
+ro.lineage.             u:object_r:build_prop:s0
+
+# Composition tuning read by hwcomposer.msm8992.so and nothing else. Unreadable, so the composer has
+# silently been running on defaults for every one of them.
+persist.hwc.            u:object_r:vendor_display_prop:s0
+persist.mdpcomp         u:object_r:vendor_display_prop:s0
+persist.metadata_dynfps. u:object_r:vendor_display_prop:s0
+
+# Data-path switches. Read by netmgrd AND by rild through libdsi_netctrl.so, so both get the type --
+# netmgrd reaches them today only because netmgrd.te grants it default_prop wholesale.
+# Deliberately NOT the whole persist.data. prefix: persist.data.iwlan.* is read by qmuxd too and
+# relabelling it would take away access that is currently working.
+persist.data.netmgrd.   u:object_r:vendor_data_prop:s0
+persist.data.tcp_rst_drop u:object_r:vendor_data_prop:s0
diff --git a/sepolicy/rild.te b/sepolicy/rild.te
index e3987fe..bbc1a11 100644
--- a/sepolicy/rild.te
+++ b/sepolicy/rild.te
@@ -24,3 +24,7 @@ dontaudit rild vendor_file:file ioctl;
 # loads libril-qc-qmi-1.so:
 #   avc: denied { read } comm="rild" name="u:object_r:vendor_rild_libpath_prop:s0"
 get_prop(rild, vendor_rild_libpath_prop)
+
+# persist.data.netmgrd.* and persist.data.tcp_rst_drop, which rild reaches through
+# libdsi_netctrl.so. It was denied these as default_prop.
+get_prop(rild, vendor_data_prop)
