+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * mm-qcamera-daemon aborts on shutdown of an ISP session:
+ *
+ *   FORTIFY: pthread_mutex_destroy called on a destroyed mutex (0xef066f84)
+ *   #03 pthread_mutex_destroy
+ *   #04 libmmcamera2_isp_modules.so
+ *   #05 liboemcamera.so
+ *
+ * The blob destroys the same mutex twice. On the Android 7 bionic this shipped against that was
+ * harmless -- the second call returned an error nobody checked. Android 13's bionic treats it as a
+ * fatal FORTIFY violation and calls abort(), so the camera daemon dies and init respawns it. Eight
+ * tombstones on a single boot here, always this signature.
+ *
+ * We cannot fix the double destroy: it is in a closed blob, on a path we do not control. What we can
+ * do is make the second call harmless again.
+ *
+ * A no-op is safe specifically because of what bionic's pthread_mutex_t is: a plain struct owned by
+ * its caller, with no heap allocation and no kernel object behind it. Destroying it only marks the
+ * memory as unusable; skipping that leaks nothing. The cost is that genuine misuse in this one
+ * daemon stops being reported -- which is the trade we want, since the "report" is a crash loop in
+ * the camera stack.
+ *
+ * Scoped to the camera daemon by TARGET_LD_SHIM_LIBS in BoardConfig.mk, so nothing else in the
+ * system loses the check.
+ */
+
+#define LOG_TAG "camera_mutex"
+
+#include <pthread.h>
+#include <stdbool.h>
+
+#include <log/log.h>
+
+int pthread_mutex_destroy(pthread_mutex_t* mutex) {
+    static bool reported = false;
+
+    (void)mutex;
+
+    if (!reported) {
+        ALOGI("camera_mutex: pthread_mutex_destroy neutralised for this process; "
+              "the ISP blob destroys mutexes twice and A13 bionic aborts on that");
+        reported = true;
+    }
+
+    return 0;
+}
