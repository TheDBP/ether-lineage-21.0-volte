diff --git a/modem_hold/modem_hold.c b/modem_hold/modem_hold.c
new file mode 100644
index 0000000..109840f
--- /dev/null
+++ b/modem_hold/modem_hold.c
@@ -0,0 +1,72 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * Boot the modem subsystem and keep it booted.
+ *
+ * Opening /dev/subsys_modem calls subsystem_get("modem") in the kernel, which
+ * loads mba.mbn and modem.mdt through PIL and brings the subsystem online. It
+ * stays online for exactly as long as some process holds that fd open. This
+ * program opens it and then does nothing else, forever.
+ *
+ * Nothing else on the device does this. On the stock ROM the job belonged to
+ * pm-service, the peripheral manager, which runs as system and brought
+ * peripherals up on behalf of clients like rild over binder. That path is gone
+ * here: libperipheral_client.so is ABI-broken against a modern libbinder (see
+ * libshims/peripheral_client), so no client can reach the peripheral manager,
+ * and vendor.qcom.PeripheralManager never registers in the first place.
+ *
+ * Without this, the whole radio stack stalls on a subsystem that never boots:
+ *
+ *   linux_qmi_qmux_io.c: Unable to open port id /dev/smdcntl0,
+ *                        error [110:Connection timed out]
+ *   qmi_client: unable to connect to server, errno=[2], attempt=49...
+ *
+ * because /dev/smdcntl* only carry traffic once the modem is up. With the
+ * subsystem held online, qmuxd opens smdcntl0, the qmux sockets appear, and
+ * rild services RIL requests normally.
+ *
+ * Runs in class core so the modem is up before qmuxd's first open rather than
+ * after it has already started timing out and retrying, and as user system
+ * because /dev/subsys_modem is 0640 system system -- rild is uid radio and
+ * cannot open it itself, which is why this is a separate service and not
+ * something folded into the RIL shim.
+ */
+
+#define LOG_TAG "ether_modem_hold"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <log/log.h>
+#include <string.h>
+#include <unistd.h>
+
+#define SUBSYS_MODEM "/dev/subsys_modem"
+
+int main(void) {
+    int fd = open(SUBSYS_MODEM, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        ALOGE("open(%s) failed: %s", SUBSYS_MODEM, strerror(errno));
+        return 1;
+    }
+
+    ALOGI("holding %s open; modem subsystem stays online", SUBSYS_MODEM);
+
+    /* Releasing the fd powers the modem back down, so never exit. */
+    for (;;) {
+        pause();
+    }
+}
diff --git a/rootdir/init.target.rc b/rootdir/init.target.rc
index f612b35..e21080b 100644
--- a/rootdir/init.target.rc
+++ b/rootdir/init.target.rc
@@ -74,6 +74,11 @@ service per_mgr /vendor/bin/pm-service
     group system
     writepid /dev/cpuset/system-background/tasks
 
+service modem_hold /vendor/bin/ether_modem_hold
+    class core
+    user system
+    group system
+
 service per_proxy /vendor/bin/pm-proxy
     class core
     user system
diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index 9a1e309..3a3e621 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -34,3 +34,6 @@
 # TimeKeep
 /sys/devices/soc\.0/qpnp-rtc-8/rtc/rtc0(/.*)?                           u:object_r:sysfs_rtc:s0
 /(system/vendor|vendor)/bin/timekeep                                    u:object_r:timekeep_exec:s0
+
+# Modem subsystem holder
+/(system/vendor|vendor)/bin/ether_modem_hold                             u:object_r:modem_hold_exec:s0
diff --git a/sepolicy/modem_hold.te b/sepolicy/modem_hold.te
new file mode 100644
index 0000000..d49b39b
--- /dev/null
+++ b/sepolicy/modem_hold.te
@@ -0,0 +1,9 @@
+# Holds /dev/subsys_modem open so the modem subsystem stays booted.
+# See modem_hold/modem_hold.c for why this exists at all.
+type modem_hold, domain;
+type modem_hold_exec, exec_type, vendor_file_type, file_type;
+
+init_daemon_domain(modem_hold)
+
+# Opening this is subsystem_get("modem"); holding it keeps the modem online.
+allow modem_hold ssr_device:chr_file r_file_perms;
