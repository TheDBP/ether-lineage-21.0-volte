diff --git a/libshims/peripheral_client/peripheral_client.c b/libshims/peripheral_client/peripheral_client.c
new file mode 100644
index 0000000..670a30a
--- /dev/null
+++ b/libshims/peripheral_client/peripheral_client.c
@@ -0,0 +1,67 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * rild crash-loops without this, roughly every five seconds, forever.
+ *
+ * libperipheral_client.so is a 2016 blob. BpPeripheralManager::registar()
+ * stack-allocates two android::Parcel objects 0x68 bytes apart, because
+ * sizeof(android::Parcel) was 0x68 when it was compiled. On 13 it is at least
+ * 0x70: Parcel::Parcel() ends with "str xzr, [x0, #0x68]". The device has no
+ * VNDK (ro.vndk.version is empty, there is no vendor libbinder), so the blob
+ * links against the current libbinder and that store lands exactly on the
+ * stack canary of registar's own frame. The result is a guaranteed
+ * __stack_chk_fail in the function prologue, before any binder traffic:
+ *
+ *   Abort message: 'stack corruption detected (-fstack-protector)'
+ *   #02 libperipheral_client.so (BpPeripheralManager::registar)
+ *   #05 libril-qc-qmi-1.so (qmi_ril_peripheral_mng_init+608)
+ *   #07 libril-qc-qmi-1.so (RIL_Init+84)
+ *
+ * Peripheral manager coordinates power-up of an *external* modem over ESOC.
+ * The Robin's modem is internal -- libmdmdetect logs "ESOC framework not
+ * supported" and "Found internal modem: modem" -- and pm-service never
+ * registers its binder service at all ("Service vendor.qcom.PeripheralManager
+ * didn't start. Returning NULL"). There is nothing here to manage.
+ *
+ * So report failure, which is the honest answer and a path the RIL already
+ * handles: qmi_ril_peripheral_mng_init checks the return with "cbz w0" and
+ * logs an error otherwise, and its caller then does "cbnz w0" and skips the
+ * rest of the ESOC setup. RIL_Init continues instead of aborting.
+ *
+ * Shimmed onto libril-qc-qmi-1.so only, so pm-service, pm-proxy and
+ * liblbs_core keep the real library.
+ */
+
+int pm_client_register(void) {
+    return -1;
+}
+
+int pm_client_unregister(void) {
+    return -1;
+}
+
+int pm_client_connect(void) {
+    return -1;
+}
+
+int pm_client_disconnect(void) {
+    return -1;
+}
+
+int pm_client_event_acknowledge(void) {
+    return -1;
+}
