diff --git a/apps/Android.mk b/apps/Android.mk
new file mode 100644
index 0000000..6fdd16b
--- /dev/null
+++ b/apps/Android.mk
@@ -0,0 +1,5 @@
+LOCAL_PATH := $(call my-dir)
+# device/nextbit/ether/Android.mk only recurses ONE level (all-subdir-makefiles globs $(1)/*/Android.mk),
+# so nested module makefiles (apps/RobinLed/Android.mk) are never included and the module is silently
+# dropped. This recurses the rest of the way.
+include $(call all-makefiles-under,$(LOCAL_PATH))
diff --git a/apps/RobinLed/Android.mk b/apps/RobinLed/Android.mk
new file mode 100644
index 0000000..0f9bd3c
--- /dev/null
+++ b/apps/RobinLed/Android.mk
@@ -0,0 +1,16 @@
+LOCAL_PATH := $(call my-dir)
+include $(CLEAR_VARS)
+
+# RobinLed — a NotificationListenerService that drives the 4 rear "cloud" LEDs (LP5523) for
+# notifications (count -> LEDs lit -> pulse rate) or as a battery gauge. Runs as system uid in the
+# robinled_app sepolicy domain (see ../../sepolicy). Platform-signed, privileged.
+LOCAL_MODULE_TAGS := optional
+LOCAL_SRC_FILES := $(call all-java-files-under, src)
+LOCAL_PACKAGE_NAME := RobinLed
+LOCAL_CERTIFICATE := platform
+LOCAL_PRIVILEGED_MODULE := true
+LOCAL_PRODUCT_MODULE := true
+LOCAL_USE_AAPT2 := true
+LOCAL_SDK_VERSION := current
+
+include $(BUILD_PACKAGE)
