diff --git a/rootdir/init.ether.led.rc b/rootdir/init.ether.led.rc
new file mode 100644
index 0000000..84b5790
--- /dev/null
+++ b/rootdir/init.ether.led.rc
@@ -0,0 +1,9 @@
+# Rear cloud LED chase while the boot animation runs. System-side on purpose: init.svc.bootanim is
+# not exported to vendor_init, so this cannot live in /vendor/etc/init (see init.nbq.led.rc).
+# Resolved path, not /sys/class/leds/lp5523:channel0/device/...: the "device" link there is labelled
+# sysfs_leds and init has no lnk_file read on it, so the write fails EACCES through the link.
+on property:init.svc.bootanim=running
+    write /sys/devices/soc.0/f9965000.i2c/i2c-9/9-0032/led_pattern 4
+
+on property:init.svc.bootanim=stopped
+    write /sys/devices/soc.0/f9965000.i2c/i2c-9/9-0032/led_pattern 0
diff --git a/rootdir/init.nbq.led.rc b/rootdir/init.nbq.led.rc
index 2ed58a7..1679092 100644
--- a/rootdir/init.nbq.led.rc
+++ b/rootdir/init.nbq.led.rc
@@ -11,9 +11,6 @@ on post-fs-data
     chmod 660 /sys/class/leds/lp5523:channel0/device/leds_on_off
     chown system system /sys/class/leds/lp5523:channel0/device/leds_on_off
 
-# happy dance during boot
-on property:init.svc.bootanim=running
-    write /sys/class/leds/lp5523:channel0/device/led_pattern 4
-
-on property:init.svc.bootanim=stopped
-    write /sys/class/leds/lp5523:channel0/device/led_pattern 0
+# The boot chase (led_pattern on init.svc.bootanim) lives in init.ether.led.rc on /system:
+# a vendor rc may only trigger on properties exported to vendor_init, and init.svc.bootanim is
+# not one, so init drops such actions at parse time ("unexported property trigger found").
diff --git a/sepolicy/robinled_app.te b/sepolicy/robinled_app.te
new file mode 100644
index 0000000..d630603
--- /dev/null
+++ b/sepolicy/robinled_app.te
@@ -0,0 +1,18 @@
+# Policy for the RobinLed app (com.nextbit.robinled). A NotificationListenerService running as
+# system uid that drives the rear LP5523 "cloud" LEDs by writing the OEM leds_on_off sysfs node
+# (labelled sysfs_leds via file_contexts). Modelled on timekeep_app.
+type robinled_app, domain;
+
+app_domain(robinled_app)
+
+# The app-facing system services (platform_app grants the same set). PowerManager alone needs
+# power_service AND thermal_service -- without thermal_service getSystemService(PowerManager)
+# returns null and onListenerConnected NPEs; the listener also needs notification_service.
+allow robinled_app app_api_service:service_manager find;
+
+# Drive the rear LED cluster: /sys/class/leds/lp5523:.../device/leds_on_off (u:object_r:sysfs_leds).
+# The "device" component of that path is a symlink carrying the same label; without lnk_file read
+# the open fails EACCES with no file-class denial in the log.
+allow robinled_app sysfs_leds:dir search;
+allow robinled_app sysfs_leds:lnk_file read;
+allow robinled_app sysfs_leds:file rw_file_perms;
