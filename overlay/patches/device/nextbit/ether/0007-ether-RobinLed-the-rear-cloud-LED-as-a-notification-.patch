+package com.nextbit.robinled;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.os.BatteryManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.PowerManager;
+import android.provider.Settings;
+import android.service.notification.NotificationListenerService;
+import android.service.notification.StatusBarNotification;
+import android.util.Log;
+
+import java.io.FileOutputStream;
+import java.io.IOException;
+
+/**
+ * Drives the Robin's 4 rear "cloud" LEDs (LP5523) as the SOLE owner of that cluster:
+ *  - Notification mode (default): the LEDs pulse for notifications. The number lit rises one per
+ *    two notifications (ceil(count/2), capped at 4); once all 4 are lit, the pulse rate ramps up
+ *    with more notifications to a capped "fast but sane" rate.
+ *  - Battery mode: the rear cluster is a static 4-bar battery gauge (the old HAL behaviour).
+ * Switch with Settings.System "robin_led_notification_mode" (1 = notifications, 0 = battery).
+ *
+ * The lights HAL no longer touches the rear cluster (see the paired lights.c change), so there is
+ * a single writer here. We write the OEM "leds_on_off" node ("<segment> <level>"), which init
+ * already chmod's to system; this app runs as system uid (sharedUserId) in the robinled_app
+ * sepolicy domain.
+ *
+ * NOTE: pulsing is done in software (a Handler ramp holding a partial wakelock while notifications
+ * are pending). That is the simplest correct-in-principle approach; offloading the pulse to the
+ * LP5523 hardware engine (engineN_load) would be the battery-friendly follow-up. Tune on device.
+ */
+public class LedNotificationListener extends NotificationListenerService {
+    private static final String TAG = "RobinLed";
+
+    private static final String LED_NODE =
+            "/sys/class/leds/lp5523:channel0/device/leds_on_off";
+    private static final int NUM_SEGMENTS = 4;
+    private static final int LEVEL_ON = 100;
+    private static final int LEVEL_OFF = 0;
+
+    private static final String KEY_MODE = "robin_led_notification_mode";
+    private static final int MODE_BATTERY = 0;
+    private static final int MODE_NOTIFICATIONS = 1;
+
+    // Pulse timing (ms). Slow breathe until all 4 are lit; then ramp toward the fast cap.
+    private static final int PULSE_SLOW_MS = 1500;
+    private static final int PULSE_FAST_MIN_MS = 300;
+    private static final int PULSE_RAMP_PER_NOTIF_MS = 120;
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private PowerManager.WakeLock mWakeLock;
+
+    private boolean mConnected;
+    private int mBatteryLevel = 100;
+
+    private int mLitSegments;        // how many rear LEDs are active
+    private int mPulseIntervalMs;    // current pulse period
+    private boolean mPulseOn;        // current phase of the software pulse
+
+    private final BroadcastReceiver mBatteryReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            int level = intent.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
+            int scale = intent.getIntExtra(BatteryManager.EXTRA_SCALE, 100);
+            if (level >= 0 && scale > 0) {
+                mBatteryLevel = level * 100 / scale;
+                if (getMode() == MODE_BATTERY) {
+                    render();
+                }
+            }
+        }
+    };
+
+    private final ContentObserver mSettingsObserver =
+            new ContentObserver(new Handler(Looper.getMainLooper())) {
+        @Override
+        public void onChange(boolean selfChange) {
+            render();
+        }
+    };
+
+    private final Runnable mPulseRunnable = new Runnable() {
+        @Override
+        public void run() {
+            mPulseOn = !mPulseOn;
+            writeSegments(mLitSegments, mPulseOn ? LEVEL_ON : LEVEL_OFF);
+            mHandler.postDelayed(this, mPulseIntervalMs);
+        }
+    };
+
+    @Override
+    public void onListenerConnected() {
+        mConnected = true;
+        PowerManager pm = getSystemService(PowerManager.class);
+        mWakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "RobinLed:pulse");
+        mWakeLock.setReferenceCounted(false);
+
+        registerReceiver(mBatteryReceiver, new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
+        getContentResolver().registerContentObserver(
+                Settings.System.getUriFor(KEY_MODE), false, mSettingsObserver);
+        render();
+    }
+
+    @Override
+    public void onListenerDisconnected() {
+        mConnected = false;
+        stopPulse();
+        try {
+            unregisterReceiver(mBatteryReceiver);
+            getContentResolver().unregisterContentObserver(mSettingsObserver);
+        } catch (IllegalArgumentException ignored) {
+        }
+    }
+
+    @Override
+    public void onNotificationPosted(StatusBarNotification sbn) {
+        render();
+    }
+
+    @Override
+    public void onNotificationRemoved(StatusBarNotification sbn) {
+        render();
+    }
+
+    private int getMode() {
+        return Settings.System.getInt(getContentResolver(), KEY_MODE, MODE_NOTIFICATIONS);
+    }
+
+    private int countNotifications() {
+        try {
+            StatusBarNotification[] active = getActiveNotifications();
+            if (active == null) {
+                return 0;
+            }
+            int n = 0;
+            for (StatusBarNotification sbn : active) {
+                // count user-dismissable notifications only (skip ongoing/foreground)
+                if (sbn.isClearable() && !sbn.isOngoing()) {
+                    n++;
+                }
+            }
+            return n;
+        } catch (SecurityException e) {
+            Log.w(TAG, "getActiveNotifications not ready", e);
+            return 0;
+        }
+    }
+
+    private void render() {
+        if (!mConnected) {
+            return;
+        }
+        if (getMode() == MODE_BATTERY) {
+            renderBattery();
+            return;
+        }
+        int count = countNotifications();
+        if (count <= 0) {
+            stopPulse();
+            writeSegments(0, LEVEL_OFF);
+            return;
+        }
+        mLitSegments = Math.min(NUM_SEGMENTS, (count + 1) / 2); // ceil(count/2)
+        int interval = PULSE_SLOW_MS;
+        if (count > NUM_SEGMENTS * 2) {
+            interval = Math.max(PULSE_FAST_MIN_MS,
+                    PULSE_SLOW_MS - (count - NUM_SEGMENTS * 2) * PULSE_RAMP_PER_NOTIF_MS);
+        }
+        startPulse(interval);
+    }
+
+    private void renderBattery() {
+        stopPulse();
+        int bars;
+        if (mBatteryLevel > 90) bars = 4;
+        else if (mBatteryLevel > 75) bars = 3;
+        else if (mBatteryLevel > 50) bars = 2;
+        else if (mBatteryLevel > 25) bars = 1;
+        else bars = 0;
+        writeSegments(bars, LEVEL_ON);
+    }
+
+    private void startPulse(int intervalMs) {
+        mPulseIntervalMs = intervalMs;
+        if (mWakeLock != null && !mWakeLock.isHeld()) {
+            mWakeLock.acquire();
+        }
+        mHandler.removeCallbacks(mPulseRunnable);
+        mPulseOn = false;
+        mHandler.post(mPulseRunnable);
+    }
+
+    private void stopPulse() {
+        mHandler.removeCallbacks(mPulseRunnable);
+        if (mWakeLock != null && mWakeLock.isHeld()) {
+            mWakeLock.release();
+        }
+    }
+
+    /** Light the first {@code litCount} rear segments at {@code level}; the rest off. */
+    private void writeSegments(int litCount, int level) {
+        for (int i = 0; i < NUM_SEGMENTS; i++) {
+            int seg = NUM_SEGMENTS - i;            // matches the HAL's segment ordering
+            int value = (i < litCount) ? level : LEVEL_OFF;
+            writeNode(LED_NODE, seg + " " + value);
+        }
+    }
+
+    private void writeNode(String path, String value) {
+        try (FileOutputStream fos = new FileOutputStream(path)) {
+            fos.write((value + "\n").getBytes());
+        } catch (IOException e) {
+            Log.w(TAG, "failed to write " + path + " = " + value, e);
+        }
+    }
+}
