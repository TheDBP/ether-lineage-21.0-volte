diff --git a/apps/RobinLed/src/com/nextbit/robinled/LedNotificationListener.java b/apps/RobinLed/src/com/nextbit/robinled/LedNotificationListener.java
new file mode 100644
index 0000000..c69a92c
--- /dev/null
+++ b/apps/RobinLed/src/com/nextbit/robinled/LedNotificationListener.java
@@ -0,0 +1,231 @@
+/*
