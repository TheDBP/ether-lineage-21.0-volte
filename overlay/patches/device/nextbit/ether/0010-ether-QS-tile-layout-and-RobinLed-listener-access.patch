-<!-- These resources are around just to allow their values to be customized
-     for different hardware and product builds. -->
+<!-- Add the NFC and LiveDisplay tiles to the default Quick Settings layout. Both features default
+     OFF (NFC via NfcService, LiveDisplay via config_defaultLiveDisplayMode), but the tiles ship in
+     the layout so each is one tap away. Order otherwise matches AOSP/Lineage's default set. -->
 <resources>
-    <!-- Doze: does this device support STATE_DOZE and STATE_DOZE_SUSPEND?  -->
-    <bool name="doze_display_state_supported">true</bool>
+    <string name="quick_settings_tiles_default" translatable="false">
+        wifi,bt,dnd,flashlight,rotation,battery,cell,airplane,nfc,livedisplay,cast,screenrecord
+    </string>
 </resources>
