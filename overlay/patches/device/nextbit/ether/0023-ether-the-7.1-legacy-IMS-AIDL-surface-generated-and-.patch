diff --git a/ims-bridge/Android.bp b/ims-bridge/Android.bp
new file mode 100644
index 0000000..2946254
--- /dev/null
+++ b/ims-bridge/Android.bp
@@ -0,0 +1,38 @@
+//
+// ImsBridge -- lets the modern telephony stack talk to ether's 7.1 ims.apk.
+//
+// platform_apis because everything it touches is @hide: android.telephony.ims.compat.*,
+// com.android.ims.internal.*, android.os.ServiceManager.
+//
+// certificate "platform" because it shares android.uid.phone with ims.apk.
+//
+package {
+    default_applicable_licenses: ["Android-Apache-2.0"],
+}
+
+android_app {
+    name: "ImsBridge",
+
+    srcs: [
+        "src/**/*.java",
+        "aidl/**/*.aidl",
+    ],
+
+    aidl: {
+        local_include_dirs: ["aidl"],
+        // The 7.1 interfaces take framework parcelables -- Surface, VideoProfile and its nested
+        // CameraCapabilities -- whose .aidl declarations live in the platform, not with us.
+        include_dirs: [
+            "frameworks/base/core/java",
+            "frameworks/base/telecomm/java",
+        ],
+    },
+
+    platform_apis: true,
+    certificate: "platform",
+    privileged: true,
+
+    optimize: {
+        enabled: false,
+    },
+}
diff --git a/ims-bridge/AndroidManifest.xml b/ims-bridge/AndroidManifest.xml
new file mode 100644
index 0000000..ba13a60
--- /dev/null
+++ b/ims-bridge/AndroidManifest.xml
@@ -0,0 +1,40 @@
+<?xml version="1.0" encoding="utf-8"?>
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="org.lineageos.ims.bridge"
+    android:sharedUserId="android.uid.phone">
+
+    <!--
+      READ_PRIVILEGED_PHONE_STATE and MODIFY_PHONE_STATE are deliberately NOT declared. Both are
+      signature|privileged, and a priv-app that requests one without a matching entry in a
+      privapp-permissions allowlist makes PackageManagerService throw at systemReady  -  which kills
+      system_server before boot completes, on every boot, with the apk itself as the only clue.
+
+      They are also unnecessary: this shares android.uid.phone, so it already runs with the phone
+      process's granted permissions, and the bridge makes no permission-guarded calls of its own.
+      If a future wrapper genuinely needs one, add it here AND to a privapp-permissions allowlist
+      in the device tree, together.
+    -->
+    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
+
+    <application
+        android:label="IMS Bridge"
+        android:directBootAware="true"
+        android:persistent="true">
+
+        <!--
+          ImsResolver looks for this action, requires the service to be protected by
+          BIND_IMS_SERVICE, and reads the MMTEL_FEATURE metadata to learn what the service offers.
+          Miss any of the three and it is skipped without a useful log line.
+        -->
+        <service
+            android:name=".ImsBridgeService"
+            android:directBootAware="true"
+            android:exported="true"
+            android:permission="android.permission.BIND_IMS_SERVICE">
+            <intent-filter>
+                <action android:name="android.telephony.ims.compat.ImsService" />
+            </intent-filter>
+            <meta-data android:name="android.telephony.ims.MMTEL_FEATURE" android:value="true" />
+        </service>
+    </application>
+</manifest>
diff --git a/ims-bridge/aidl/android/view/Surface.aidl b/ims-bridge/aidl/android/view/Surface.aidl
new file mode 100644
index 0000000..e456650
--- /dev/null
+++ b/ims-bridge/aidl/android/view/Surface.aidl
@@ -0,0 +1,9 @@
+package android.view;
+
+/*
+ * android.view.Surface is a framework parcelable with no .aidl of its own -- the platform resolves
+ * it through framework.aidl's preprocessed parcelable list, which a device module does not get.
+ * Declaring it here only tells aidl "this is a parcelable"; the real class still comes from the
+ * framework at runtime.
+ */
+parcelable Surface;
