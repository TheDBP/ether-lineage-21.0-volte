From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Thu, 17 Sep 2026 17:34:14 -0400
Subject: [PATCH] kdeconnect: bundle KDE Connect

vendor/lineage/prebuilts/kdeconnect module, installed unmodified, plus a guarded PRODUCT_PACKAGES
line in config/common.mk. The APK is fetched by the kdeconnect option's fetch.sh (the current
F-Droid build, signer-pinned); the module is a no-op without it.

Soong branch: the patch ships no module file. Android.bp is written by the fetcher (gitignored),
because skip_preprocessed_apk_checks has to match what each release of the APK packs, and an APK
whose native libraries are compressed gets them unpacked beside it and installed by jni/Android.mk.
---
 config/common.mk                    |  8 ++++++++
 prebuilts/kdeconnect/.gitignore     |  8 ++++++++
 prebuilts/kdeconnect/jni/Android.mk | 27 +++++++++++++++++++++++++++
 3 files changed, 43 insertions(+)
 create mode 100644 prebuilts/kdeconnect/.gitignore
 create mode 100644 prebuilts/kdeconnect/jni/Android.mk

diff --git a/config/common.mk b/config/common.mk
index 3b68625..72e81c0 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -222,6 +222,14 @@ PRODUCT_COPY_FILES += \
 PRODUCT_PACKAGES_DEBUG += \
     disable-overlays
 
+# kdeconnect option: KDE Connect (phone <-> desktop). Guarded on the fetched APK so a build without
+# the option (no APK) is unaffected; require.sh fails the build if the option is on and the APK is missing.
+ifneq ($(wildcard vendor/lineage/prebuilts/kdeconnect/KDEConnect.apk),)
+PRODUCT_PACKAGES += KDEConnect
+# Native libraries the fetcher unpacked beside the APK, one module each (prebuilts/kdeconnect/jni).
+PRODUCT_PACKAGES += $(patsubst %.so,KDEConnect_jni_%,$(notdir $(wildcard vendor/lineage/prebuilts/kdeconnect/lib/arm64-v8a/*.so)))
+endif
+
 # rsync
 PRODUCT_PACKAGES += \
     rsync
diff --git a/prebuilts/kdeconnect/.gitignore b/prebuilts/kdeconnect/.gitignore
new file mode 100644
index 0000000..b3b41c3
--- /dev/null
+++ b/prebuilts/kdeconnect/.gitignore
@@ -0,0 +1,8 @@
+# Everything here but jni/ is written by the kdeconnect option (forge/prebuilt/fetch-kdeconnect.sh):
+# the APK, the native libraries it unpacks beside it when the APK packs them compressed, and the
+# Soong module file, which it writes per fetch because skip_preprocessed_apk_checks must match
+# the APK.
+*.apk
+*.apk.download
+/lib/
+/Android.bp
diff --git a/prebuilts/kdeconnect/jni/Android.mk b/prebuilts/kdeconnect/jni/Android.mk
new file mode 100644
index 0000000..4b1a2e0
--- /dev/null
+++ b/prebuilts/kdeconnect/jni/Android.mk
@@ -0,0 +1,27 @@
+# KDEConnect native libraries. The APK is installed byte for byte (see ../Android.bp, written by the
+# fetcher) and PackageManager does not extract native libraries for a bundled app, so when
+# fetch-kdeconnect.sh finds them compressed or unaligned in the APK it unpacks lib/arm64-v8a/ beside it,
+# and these install as app/KDEConnect/lib/arm64/. One Make module per library: the build refuses ELF
+# files in PRODUCT_COPY_FILES, and no Soong prebuilt type installs under app/. common.mk adds the
+# modules to PRODUCT_PACKAGES from the same wildcard. Nothing is defined when nothing was unpacked.
+LOCAL_PATH := $(call my-dir)/..
+
+KDECONNECT_JNI_LIBS := $(notdir $(wildcard $(LOCAL_PATH)/lib/arm64-v8a/*.so))
+
+define kdeconnect-jni-module
+include $$(CLEAR_VARS)
+LOCAL_MODULE := KDEConnect_jni_$(1:.so=)
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_STEM := $(1:.so=)
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_MODULE_TAGS := optional
+LOCAL_SRC_FILES := lib/arm64-v8a/$(1)
+LOCAL_MULTILIB := 64
+LOCAL_PRODUCT_MODULE := true
+LOCAL_MODULE_PATH := $$(TARGET_OUT_PRODUCT)/app/KDEConnect/lib/arm64
+LOCAL_STRIP_MODULE := false
+LOCAL_CHECK_ELF_FILES := false
+include $$(BUILD_PREBUILT)
+endef
+
+$(foreach lib,$(KDECONNECT_JNI_LIBS),$(eval $(call kdeconnect-jni-module,$(lib))))
-- 
