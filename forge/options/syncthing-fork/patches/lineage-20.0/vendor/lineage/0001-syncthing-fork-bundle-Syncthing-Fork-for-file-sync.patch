From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Sun, 20 Sep 2026 13:12:30 -0400
Subject: [PATCH] syncthing-fork: bundle Syncthing-Fork for file sync

vendor/lineage/prebuilts/syncthing-fork modules, installed unmodified, plus a guarded
PRODUCT_PACKAGES block in config/common.mk. The APK is fetched by the syncthing-fork option's
fetch.sh (the current F-Droid build, signer-pinned); the modules are a no-op without it.

The Syncthing core is not a library the app loads: it execs nativeLibraryDir/libsyncthingnative.so,
and fs_config makes everything under product/app/ 0644, so it cannot live beside the APK. The
fetcher extracts it and SyncthingFork_core installs it as product/bin/syncthing (0755) with a
relative symlink back at the path the app execs.
---
 config/common.mk                    |  9 ++++++
 prebuilts/syncthing-fork/.gitignore |  8 +++++
 prebuilts/syncthing-fork/Android.mk | 47 +++++++++++++++++++++++++++++
 3 files changed, 64 insertions(+)
 create mode 100644 prebuilts/syncthing-fork/.gitignore
 create mode 100644 prebuilts/syncthing-fork/Android.mk

diff --git a/config/common.mk b/config/common.mk
index 985e611c..6013c805 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -75,6 +75,15 @@ PRODUCT_COPY_FILES += \
 PRODUCT_COPY_FILES += \
     frameworks/base/data/keyboards/Vendor_045e_Product_028e.kl:$(TARGET_COPY_OUT_PRODUCT)/usr/keylayout/Vendor_045e_Product_0719.kl
 
+# syncthing-fork option: Syncthing-Fork, continuous file sync between your own devices, no server.
+# Guarded on the fetched APK so a build without the option (no APK) is unaffected; require.sh
+# fails the build if the option is on and the APK is missing. SyncthingFork_core is the Syncthing
+# core, which the app execs rather than loads and which product/app/ (0644 by fs_config) could
+# therefore never hold: it installs as product/bin/syncthing with a symlink back where the app looks.
+ifneq ($(wildcard vendor/lineage/prebuilts/syncthing-fork/SyncthingFork.apk),)
+PRODUCT_PACKAGES += SyncthingFork SyncthingFork_core
+endif
+
 # This is Lineage!
 PRODUCT_COPY_FILES += \
     vendor/lineage/config/permissions/org.lineageos.android.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/permissions/org.lineageos.android.xml
diff --git a/prebuilts/syncthing-fork/.gitignore b/prebuilts/syncthing-fork/.gitignore
new file mode 100644
index 00000000..cd93309e
--- /dev/null
+++ b/prebuilts/syncthing-fork/.gitignore
@@ -0,0 +1,8 @@
+# Everything here but Android.mk is written by the syncthing-fork option
+# (forge/prebuilt/fetch-syncthing-fork.sh): the APK, the native libraries it unpacks beside it,
+# and the Syncthing core it extracts for product/bin.
+*.apk
+*.apk.download
+/lib/
+/syncthing
+/syncthing.download
diff --git a/prebuilts/syncthing-fork/Android.mk b/prebuilts/syncthing-fork/Android.mk
new file mode 100644
index 00000000..3ba4e7d4
--- /dev/null
+++ b/prebuilts/syncthing-fork/Android.mk
@@ -0,0 +1,47 @@
+LOCAL_PATH := $(call my-dir)
+# Syncthing-Fork (com.github.catfriend1.syncthingfork), PRESIGNED by Catfriend1. The APK is fetched,
+# signer-verified, by the syncthing-fork option's fetch.sh and is gitignored, never committed.
+# Defined only when it is present; see config/common.mk.
+ifneq ($(wildcard $(LOCAL_PATH)/SyncthingFork.apk),)
+include $(CLEAR_VARS)
+LOCAL_MODULE := SyncthingFork
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+LOCAL_BUILT_MODULE_STEM := package.apk
+LOCAL_CERTIFICATE := PRESIGNED
+# Ship the APK byte for byte: without LOCAL_SDK_VERSION the build rewrites it, which invalidates
+# the whole-file v2 signature and PackageManager then drops the package at boot scan, silently.
+LOCAL_SDK_VERSION := current
+# The native libraries the fetcher unpacked (the release packs them compressed), installed beside
+# the APK where PackageManager looks for a bundled app's. The core is not a library; see below.
+LOCAL_PREBUILT_JNI_LIBS := $(filter-out %/libsyncthingnative.so,$(patsubst $(LOCAL_PATH)/%,%,$(wildcard $(LOCAL_PATH)/lib/arm64-v8a/*.so)))
+# The <uses-library> check is off: the APK is whatever F-Droid's current build is at fetch time.
+LOCAL_ENFORCE_USES_LIBRARIES := false
+LOCAL_SRC_FILES := SyncthingFork.apk
+LOCAL_PRODUCT_MODULE := true
+LOCAL_DEX_PREOPT := false
+include $(BUILD_PREBUILT)
+endif
+
+# The Syncthing core. The app runs it as a process -- ProcessBuilder on
+# nativeLibraryDir/libsyncthingnative.so -- not via dlopen, and fs_config gives every file under
+# product/app/ mode 0644, so a copy beside the APK can never be executed. Installed instead as
+# product/bin/syncthing (0755 by fs_config, system_file, which appdomain may execute) with a
+# relative symlink at the path the app execs. The fetcher extracts ../syncthing from the APK on
+# every run, whether or not the rest of the libraries needed unpacking.
+ifneq ($(wildcard $(LOCAL_PATH)/syncthing),)
+include $(CLEAR_VARS)
+LOCAL_MODULE := SyncthingFork_core
+LOCAL_MODULE_STEM := syncthing
+LOCAL_MODULE_CLASS := EXECUTABLES
+LOCAL_MODULE_TAGS := optional
+LOCAL_SRC_FILES := syncthing
+LOCAL_MULTILIB := 64
+LOCAL_PRODUCT_MODULE := true
+LOCAL_STRIP_MODULE := false
+LOCAL_CHECK_ELF_FILES := false
+LOCAL_POST_INSTALL_CMD := mkdir -p $(TARGET_OUT_PRODUCT)/app/SyncthingFork/lib/arm64 && \
+    ln -sfn ../../../../bin/syncthing $(TARGET_OUT_PRODUCT)/app/SyncthingFork/lib/arm64/libsyncthingnative.so
+include $(BUILD_PREBUILT)
+endif
