From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Sun, 20 Sep 2026 13:12:30 -0400
Subject: [PATCH] syncthing-fork: bundle Syncthing-Fork for file sync

vendor/lineage/prebuilts/syncthing-fork modules, installed unmodified, plus a guarded
PRODUCT_PACKAGES block in config/common.mk. The APK is fetched by the syncthing-fork option's
fetch.sh (the current F-Droid build, signer-pinned); the modules are a no-op without it.

The Syncthing core is not a library the app loads: it execs nativeLibraryDir/libsyncthingnative.so,
and fs_config makes everything under product/app/ 0644, so it cannot live beside the APK. The
fetcher extracts it and SyncthingFork_core installs it as product/bin/syncthing (0755) with a
relative symlink back at the path the app execs.
---
 config/common.mk                        | 12 +++++++
 prebuilts/syncthing-fork/.gitignore     | 10 ++++++
 prebuilts/syncthing-fork/jni/Android.mk | 48 +++++++++++++++++++++++++
 3 files changed, 70 insertions(+)
 create mode 100644 prebuilts/syncthing-fork/.gitignore
 create mode 100644 prebuilts/syncthing-fork/jni/Android.mk

diff --git a/config/common.mk b/config/common.mk
index 5265427b..a348271f 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -86,6 +86,18 @@ PRODUCT_PACKAGES += \
 PRODUCT_COPY_FILES += \
     frameworks/base/data/keyboards/Vendor_045e_Product_028e.kl:$(TARGET_COPY_OUT_PRODUCT)/usr/keylayout/Vendor_045e_Product_0719.kl
 
+# syncthing-fork option: Syncthing-Fork, continuous file sync between your own devices, no server.
+# Guarded on the fetched APK so a build without the option (no APK) is unaffected; require.sh
+# fails the build if the option is on and the APK is missing.
+# Native libraries the fetcher unpacked beside the APK, if any, install as one module each
+# (prebuilts/syncthing-fork/jni) -- all but the Syncthing core, which the app execs rather than
+# loads and which product/app/ (0644 by fs_config) could therefore never hold: SyncthingFork_core
+# installs it as product/bin/syncthing with a symlink back where the app looks.
+ifneq ($(wildcard vendor/lineage/prebuilts/syncthing-fork/SyncthingFork.apk),)
+PRODUCT_PACKAGES += SyncthingFork SyncthingFork_core
+PRODUCT_PACKAGES += $(patsubst %.so,SyncthingFork_jni_%,$(filter-out libsyncthingnative.so,$(notdir $(wildcard vendor/lineage/prebuilts/syncthing-fork/lib/arm64-v8a/*.so))))
+endif
+
 # Component overrides
 PRODUCT_PACKAGES += \
     lineage-component-overrides.xml
diff --git a/prebuilts/syncthing-fork/.gitignore b/prebuilts/syncthing-fork/.gitignore
new file mode 100644
index 00000000..3ea597ac
--- /dev/null
+++ b/prebuilts/syncthing-fork/.gitignore
@@ -0,0 +1,10 @@
+# Everything here but jni/ is written by the syncthing-fork option
+# (forge/prebuilt/fetch-syncthing-fork.sh): the APK, the native libraries it unpacks beside it, the
+# Syncthing core it extracts for product/bin, and the Soong module file, which it writes per fetch
+# because skip_preprocessed_apk_checks must match the APK.
+*.apk
+*.apk.download
+/lib/
+/syncthing
+/syncthing.download
+/Android.bp
diff --git a/prebuilts/syncthing-fork/jni/Android.mk b/prebuilts/syncthing-fork/jni/Android.mk
new file mode 100644
index 00000000..7ed27b01
--- /dev/null
+++ b/prebuilts/syncthing-fork/jni/Android.mk
@@ -0,0 +1,48 @@
+# Syncthing-Fork native libraries. The APK is installed byte for byte (see ../Android.bp, written
+# by the fetcher) and PackageManager does not extract native libraries for a bundled app, so
+# fetch-syncthing-fork.sh unpacks lib/arm64-v8a/ beside it whenever a release packs them compressed
+# (every release so far) and these install as app/SyncthingFork/lib/arm64/. libsyncthingnative.so
+# is left out: it is the core, handled below.
+LOCAL_PATH := $(call my-dir)/..
+
+SYNCTHINGFORK_JNI_LIBS := $(filter-out libsyncthingnative.so,$(notdir $(wildcard $(LOCAL_PATH)/lib/arm64-v8a/*.so)))
+
+define syncthingfork-jni-module
+include $$(CLEAR_VARS)
+LOCAL_MODULE := SyncthingFork_jni_$(1:.so=)
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_STEM := $(1:.so=)
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_MODULE_TAGS := optional
+LOCAL_SRC_FILES := lib/arm64-v8a/$(1)
+LOCAL_MULTILIB := 64
+LOCAL_PRODUCT_MODULE := true
+LOCAL_MODULE_PATH := $$(TARGET_OUT_PRODUCT)/app/SyncthingFork/lib/arm64
+LOCAL_STRIP_MODULE := false
+LOCAL_CHECK_ELF_FILES := false
+include $$(BUILD_PREBUILT)
+endef
+
+$(foreach lib,$(SYNCTHINGFORK_JNI_LIBS),$(eval $(call syncthingfork-jni-module,$(lib))))
+
+# The Syncthing core. The app runs it as a process -- ProcessBuilder on
+# nativeLibraryDir/libsyncthingnative.so -- not via dlopen, and fs_config gives every file under
+# product/app/ mode 0644, so a copy beside the APK can never be executed. Installed instead as
+# product/bin/syncthing (0755 by fs_config, system_file, which appdomain may execute) with a
+# relative symlink at the path the app execs. The fetcher extracts ../syncthing from the APK on
+# every run, whether or not the rest of the libraries needed unpacking.
+ifneq ($(wildcard $(LOCAL_PATH)/syncthing),)
+include $(CLEAR_VARS)
+LOCAL_MODULE := SyncthingFork_core
+LOCAL_MODULE_STEM := syncthing
+LOCAL_MODULE_CLASS := EXECUTABLES
+LOCAL_MODULE_TAGS := optional
+LOCAL_SRC_FILES := syncthing
+LOCAL_MULTILIB := 64
+LOCAL_PRODUCT_MODULE := true
+LOCAL_STRIP_MODULE := false
+LOCAL_CHECK_ELF_FILES := false
+LOCAL_POST_INSTALL_CMD := mkdir -p $(TARGET_OUT_PRODUCT)/app/SyncthingFork/lib/arm64 && \
+    ln -sfn ../../../../bin/syncthing $(TARGET_OUT_PRODUCT)/app/SyncthingFork/lib/arm64/libsyncthingnative.so
+include $(BUILD_PREBUILT)
+endif
