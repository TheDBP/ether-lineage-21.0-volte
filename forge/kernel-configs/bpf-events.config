# bpf-events -- register the tracing BPF program types.
#
# BPF_PROG_TYPE_TRACEPOINT, _KPROBE and _PERF_EVENT are only added to the kernel's program-type
# table under CONFIG_BPF_EVENTS. Without it find_prog_type() rejects them, and it does so before
# the verifier runs: the load comes back as a bare EINVAL with an empty verifier log, which looks
# like a malformed program rather than a missing feature. Socket-filter and cgroup programs are
# unaffected, so networking BPF works and only the tracing objects fail -- on Android that is
# every .bpf under /system/etc/bpf (gpuMem, gpuWork, memevents, kernelWakelockDuration, ...).
#
# BPF_EVENTS is a non-prompt bool that defaults to y once its dependencies are met, so the
# dependencies are what actually have to be turned on: PERF_EVENTS (already on everywhere Android
# runs) and one of KPROBE_EVENT or UPROBE_EVENT, each of which needs its own probe support.
#
# Note this turns on kprobes, a general kernel tracing primitive. That is what mainline Android
# kernels ship, but it is a real capability to hand a device and worth a deliberate decision
# rather than an accident.
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENT=y
CONFIG_BPF_EVENTS=y
