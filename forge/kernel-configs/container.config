# container.config -- kernel options a Linux container runtime (Docker/podman/LXC/nspawn) needs,
# which Android kernels ship with off. Supplied by the `linux` option (KERNEL_CONFIGS), or per
# device with KERNEL_EXTRA_CONFIGS="container". apply-overlay.sh merges it as a fragment target
# where scripts/kconfig has the %.config rule (3.18+) and appends it to the base defconfig
# otherwise (3.10); TARGET_KERNEL_CONFIG_EXT is not used (GOTCHAS 13).
#
# Audited against Docker's own required-features list. On bonito (4.9) 18 of 26 were already
# present; everything below is what was missing, minus CONFIG_USER_NS (see the note at the bottom).
# Options that do not exist on a given kernel are simply reported by merge_config.sh and skipped,
# so this fragment is safe to apply to 3.10, 3.18 and 4.9 alike.

# --- namespaces: the actual isolation ---
CONFIG_PID_NS=y
CONFIG_IPC_NS=y

# --- cgroup controllers Docker checks for ---
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y

# --- container networking (bridge + NAT for the default docker0 bridge) ---
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- misc runtime requirements ---
CONFIG_POSIX_MQUEUE=y
# Separate devpts instance per container; only exists on kernels before it was made unconditional.
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
# overlay2 is Docker's preferred storage driver. Already on for bonito/vs995; this covers ether.
CONFIG_OVERLAY_FS=y
# Some container images ship as squashfs.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# --- resource limits (--cpus, --memory, --blkio-weight) ---
# Without these dockerd starts but silently ignores most limit flags.
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_DEV_THROTTLING=y
# CONFIG_CGROUP_HUGETLB / CONFIG_HUGETLBFS are deliberately NOT enabled.
# Docker treats hugetlb cgroups as optional, and turning them on breaks old arm64 kernels that
# lack the arch-side implementation -- ether's 3.10 fails to link vmlinux with
#   undefined reference to `huge_pte_offset' / `huge_pte_alloc' / `huge_pmd_unshare'
# Not worth a broken kernel for a limit almost nobody sets.
CONFIG_CGROUP_PERF=y
CONFIG_MEMCG_KMEM=y

# --- network cgroups + extra network drivers ---
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_DUMMY=y
CONFIG_BRIDGE_VLAN_FILTERING=y

# --- required by the runtime / used by docker info ---
# FHANDLE in particular: name_to_handle_at() is a hard requirement.
# CONFIG_FHANDLE lives in container-fhandle.config -- it conflicts with Android's VINTF kernel
# requirements on some devices (see that file).
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_BINFMT_MISC=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# --- keyring bits containerd uses ---
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_PERSISTENT_KEYRINGS=y
CONFIG_ENCRYPTED_KEYS=y

# --- socket diagnostics (docker inspect / netstat inside containers) ---
CONFIG_NETLINK_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_UNIX_DIAG=y

# --- devicemapper storage driver, as a fallback to overlay2 ---
CONFIG_BLK_DEV_DM=y
CONFIG_DM_THIN_PROVISIONING=y

# --- deliberately NOT enabled ---
# CONFIG_USER_NS is not set
#   Docker only needs it for rootless mode / userns-remap, and it has a long history of local
#   privilege-escalation CVEs. Android disables it on purpose. Leave it off on kernels this old;
#   enable it knowingly, per device, if you actually need rootless containers.
#
# CONFIG_SECURITY_APPARMOR -- Docker ships AppArmor profiles, but Android uses SELinux and enabling
#   a second LSM here buys nothing. Docker runs fine with --security-opt apparmor=unconfined.
# CONFIG_AUFS_FS / CONFIG_BTRFS_FS -- alternative storage drivers we do not need; overlay2 on the
#   ext4 loop image is the supported path (see modules/linux-chroot).
# CONFIG_IP_VS* -- Swarm service load-balancing only.
