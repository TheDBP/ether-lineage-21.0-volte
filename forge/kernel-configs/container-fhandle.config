# container-fhandle.config -- CONFIG_FHANDLE, split out because it is the one container option that
# Android actively forbids on some devices.
#
# dockerd uses name_to_handle_at(); Docker lists FHANDLE as generally necessary. But
# system/etc/vintf/compatibility_matrix.5.xml requires it OFF:
#
#   <kernel version="4.4.302" level="5"> ... <key>CONFIG_FHANDLE</key><value type="tristate">n</value>
#
# so on a device that enforces kernel VINTF requirements, enabling it fails the build:
#   ERROR: ... No compatible kernel requirement found (kernel FCM version = 5).
#   For config CONFIG_FHANDLE, value = y but required n
#
# vs995 hits this: device/lge/msm8996-common/msm8996.mk sets
# PRODUCT_OTA_ENFORCE_VINTF_KERNEL_REQUIREMENTS := true deliberately.
#
# bonito hits it too, on lineage-22.2 -- an earlier note here claimed it did not. That was only true
# of our lineage-23.0 tree, where a device patch turns enforcement off explicitly; the stock 22.2
# tree enforces it and fails the same way at matrix levels 5 and 6. ether builds clean with it.
#
# Default is ON via WITH_LINUX; set WITH_LINUX_FHANDLE=false per device to drop it.
CONFIG_FHANDLE=y
